#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local AI assistant settings and code index
/.claude/settings.local.json
/.codegraph/

# release 资源由 third_party/data/resources.json 固定来源，payload 只进入 generated。
/android/app/src/main/assets/certificates/*.pem
/android/app/src/main/assets/geodata/GeoIP.dat
/android/app/src/main/assets/geodata/GeoSite.dat
/android/app/src/main/assets/geodata/dbip-country-lite.mmdb.gzip
/android/app/src/main/assets/geodata/dbip-asn-lite.mmdb.gzip
