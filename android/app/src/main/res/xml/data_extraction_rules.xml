<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup and device transfer include only the three application data files, excluding the installation privacy marker in noBackupFilesDir. -->
    <cloud-backup>
        <include domain="file" path="configurations/configurations.json" />
        <include domain="file" path="configurations/preferences.json" />
        <include domain="file" path="configurations/overrides.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="configurations/configurations.json" />
        <include domain="file" path="configurations/preferences.json" />
        <include domain="file" path="configurations/overrides.json" />
    </device-transfer>
</data-extraction-rules>
