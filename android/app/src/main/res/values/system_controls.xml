<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="system_control_surface">#FFFEFA</color>
    <color name="system_control_outline">#E9E3D8</color>
    <color name="system_control_text">#2E302C</color>
    <color name="system_control_secondary">#706A5F</color>
    <style name="WidgetControlTextBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:textColor">@color/system_control_secondary</item>
    </style>
    <style name="WidgetControlText" parent="WidgetControlTextBase" />
    <style name="WidgetControlStatus" parent="WidgetControlText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/system_control_text</item>
    </style>
    <style name="WidgetControlMode" parent="WidgetControlText">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="WidgetControlCapsule">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/widget_control_hit</item>
        <item name="android:tint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:enabled">false</item>
    </style>
    <string name="widget_measure_line" translatable="false">Ag国</string>
</resources>
