<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/widget_square"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <TextView
            android:id="@+id/widget_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:width="144dp"
            android:height="144dp"
            android:visibility="invisible"
            android:importantForAccessibility="no"
            android:focusable="false"
            android:clickable="false" />
        <RelativeLayout
            android:id="@+id/widget_open"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignStart="@id/widget_size"
            android:layout_alignEnd="@id/widget_size"
            android:layout_alignTop="@id/widget_size"
            android:layout_alignBottom="@id/widget_size"
            android:background="@drawable/widget_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/system_control_widget_description">
            <LinearLayout
                android:id="@+id/widget_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">
                <RelativeLayout
                    android:id="@+id/widget_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <ImageView
                        android:id="@+id/widget_logo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/widget_logo"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"
                        android:focusable="false"
                        android:clickable="false" />
                    <ImageButton
                        android:id="@+id/widget_control"
                        style="@style/WidgetControlCapsule"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/widget_switch_unknown"
                        android:contentDescription="@string/system_control_capsule_unavailable" />
                </RelativeLayout>
                <FrameLayout
                    android:id="@+id/widget_status_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp">
                    <TextView
                        style="@style/WidgetControlStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_measure_line"
                        android:visibility="invisible"
                        android:importantForAccessibility="no"
                        android:focusable="false"
                        android:clickable="false" />
                    <TextView
                        android:id="@+id/widget_status"
                        style="@style/WidgetControlStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/widget_unknown"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/widget_mode_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/WidgetControlMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_measure_line"
                        android:visibility="invisible"
                        android:importantForAccessibility="no"
                        android:focusable="false"
                        android:clickable="false" />
                    <TextView
                        android:id="@+id/widget_mode"
                        style="@style/WidgetControlMode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/widget_mode_unknown"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/widget_capacity"
                style="@style/WidgetControlCapacity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/widget_capacity"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
