{
  "groupCommon": {
    "name": "fixture-group",
    "proxies": ["REJECT"],
    "use": ["fixture-provider"],
    "url": "https://fixture.invalid/ping",
    "interval": 0,
    "timeout": 321,
    "max-failed-times": 4,
    "empty-fallback": "REJECT",
    "lazy": false,
    "disable-udp": false,
    "filter": ".*",
    "exclude-filter": "^never$",
    "exclude-type": "ss|vmess",
    "expected-status": "200-299",
    "include-all": false,
    "include-all-proxies": false,
    "include-all-providers": false,
    "hidden": false,
    "icon": "https://fixture.invalid/icon.svg"
  },
  "groups": [
    {"id": "select", "special": {"type": "select", "default-selected": "REJECT"}},
    {"id": "url-test", "special": {"type": "url-test", "tolerance": 20}},
    {"id": "fallback", "special": {"type": "fallback"}},
    {"id": "load-balance", "special": {"type": "load-balance", "strategy": "sticky-sessions", "hash-key": "in-user"}}
  ],
  "proxyProviderCommon": {
    "filter": ".*",
    "exclude-filter": "^never$",
    "exclude-type": "ss|vmess",
    "dialer-proxy": "future-egress",
    "age-secret-key": "",
    "health-check": {
      "enable": false,
      "url": "https://fixture.invalid/ping",
      "interval": 0,
      "timeout": 321,
      "lazy": false,
      "expected-status": "200-299"
    },
    "override": {
      "tfo": false,
      "mptcp": false,
      "udp": false,
      "udp-over-tcp": false,
      "up": "10",
      "down": "20",
      "dialer-proxy": "future-egress",
      "skip-cert-verify": false,
      "name-cert-verify": "",
      "interface-name": "",
      "routing-mark": 0,
      "ip-version": "ipv4",
      "additional-prefix": "pre-",
      "additional-suffix": "-post",
      "proxy-name": [{"pattern": "origin", "target": "base"}],
      "override-expr": [".name = .name + \"-expr\""]
    },
    "payload": [{"name": "origin", "type": "http", "server": "127.0.0.1", "port": 1080}]
  },
  "transports": [
    {"type": "http", "url": "https://fixture.invalid/provider?token=synthetic", "path": "providers/explicit-cache.yaml", "proxy": "future-egress", "interval": 0, "size-limit": 4096, "header": {"X-Fixture": ["first", "second"], "X-Empty": [""]}},
    {"type": "file", "path": "providers/local.yaml", "interval": 0},
    {"type": "inline"}
  ],
  "ruleProviders": [
    {"id": "domain-yaml", "behavior": "domain", "format": "yaml", "payload": ["+.example.test", "exact.example.test"], "path-in-bundle": "rules/fixture.yaml"},
    {"id": "domain-text", "behavior": "domain", "format": "text", "payload": ["+.example.test", "exact.example.test"], "path-in-bundle": "rules/fixture.txt"},
    {"id": "domain-mrs", "behavior": "domain", "format": "mrs", "payload": ["+.example.test", "exact.example.test"], "path-in-bundle": "rules/fixture.mrs"},
    {"id": "ipcidr-yaml", "behavior": "ipcidr", "format": "yaml", "payload": ["192.0.2.0/24", "2001:db8::/32"], "path-in-bundle": "rules/fixture.yaml"},
    {"id": "ipcidr-text", "behavior": "ipcidr", "format": "text", "payload": ["192.0.2.0/24", "2001:db8::/32"], "path-in-bundle": "rules/fixture.txt"},
    {"id": "ipcidr-mrs", "behavior": "ipcidr", "format": "mrs", "payload": ["192.0.2.0/24", "2001:db8::/32"], "path-in-bundle": "rules/fixture.mrs"},
    {"id": "classical-yaml", "behavior": "classical", "format": "yaml", "payload": ["DOMAIN,example.test", "DST-PORT,443"], "path-in-bundle": "rules/fixture.yaml"},
    {"id": "classical-text", "behavior": "classical", "format": "text", "payload": ["DOMAIN,example.test", "DST-PORT,443"], "path-in-bundle": "rules/fixture.txt"}
  ],
  "rules": [
    ["DOMAIN", "example.test"],
    ["DOMAIN-SUFFIX", "example.test"],
    ["DOMAIN-KEYWORD", "example"],
    ["DOMAIN-REGEX", "^example(,test)?$"],
    ["DOMAIN-WILDCARD", "*.example.test"],
    ["GEOSITE", "fixture"],
    ["GEOIP", "lan"],
    ["SRC-GEOIP", "lan"],
    ["IP-ASN", "64512"],
    ["SRC-IP-ASN", "64512"],
    ["IP-CIDR", "192.0.2.0/24"],
    ["IP-CIDR6", "2001:db8::/32"],
    ["SRC-IP-CIDR", "192.0.2.0/24"],
    ["IP-SUFFIX", "0.0.2.1/16"],
    ["SRC-IP-SUFFIX", "0.0.2.1/16"],
    ["SRC-PORT", "1000-2000/443"],
    ["DST-PORT", "443"],
    ["IN-PORT", "7890"],
    ["DSCP", "0-63"],
    ["PROCESS-NAME", "synthetic"],
    ["PROCESS-PATH", "/synthetic/process"],
    ["PROCESS-NAME-REGEX", "^synthetic(,test)?$"],
    ["PROCESS-PATH-REGEX", "^/synthetic(,test)?$"],
    ["PROCESS-NAME-WILDCARD", "synthetic*"],
    ["PROCESS-PATH-WILDCARD", "/synthetic/*"],
    ["NETWORK", "UDP"],
    ["UID", "1000-2000"],
    ["IN-TYPE", "SOCKS/HTTP"],
    ["IN-USER", "first/second"],
    ["IN-NAME", "first/second"],
    ["REMATCH-NAME", "first/second"],
    ["SUB-RULE", "(DOMAIN,example.test)"],
    ["AND", "((DOMAIN,example.test),(DST-PORT,443))"],
    ["OR", "((DOMAIN,example.test),(NETWORK,UDP))"],
    ["NOT", "((DOMAIN,example.test))"],
    ["RULE-SET", "fixture-rules"],
    ["MATCH", null]
  ]
}
